# Bootstrap rustup; the copied native manifest selects the test compiler.
FROM rust:1.100.0-slim-bookworm

RUN apt-get update -y && apt-get install --no-install-recommends -y \
        build-essential cmake clang libclang-dev ninja-build \
        iputils-ping dnsutils traceroute mtr-tiny curl openssl iproute2 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

CMD ["cargo", "test", "--locked", "--workspace", "--exclude", "globalping-behavior", "--", "--nocapture"]
