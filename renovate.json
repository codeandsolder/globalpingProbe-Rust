{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "prConcurrentLimit": 6,
  "prHourlyLimit": 3,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am"],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Group ordinary compatible stable Rust dependency updates after CI",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "routine stable Rust dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Cargo lockfile maintenance is age-gated by repository CI",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Potentially breaking pre-1.0 updates are reviewed individually",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Major Rust dependency updates are reviewed individually",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Package replacements stay open for review",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["replacement"],
      "minimumReleaseAge": null,
      "automerge": false
    }
  ]
}
